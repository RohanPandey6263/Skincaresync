# SkincareSync production environment.
#
#     cp deploy/env.production.example .env.deploy
#     docker compose --env-file .env.deploy up -d --build
#
# Keep this file out of the image and out of git: it holds the database
# password, the SMTP credentials and the OAuth client secrets. `.env.deploy` is
# gitignored; `.dockerignore` keeps `.env` out of image layers.
#
# skincaresync/config.py validates most of this at import. A wrong value here
# is a container that exits at boot with a named problem, not a service that
# comes up and misbehaves quietly.

# --- Database ---------------------------------------------------------------
PGDATABASE=skincaresync
PGUSER=skincaresync
# Required. Generate one: openssl rand -base64 32
PGPASSWORD=

# Only for a managed database reached over the network. libpq reads this
# directly; neither connection path in the app passes sslmode explicitly.
# PGSSLMODE=require

# --- Origins ----------------------------------------------------------------
# Both must be https in production and neither may end in a slash.
#
# With the bundled nginx the SPA and the API share one origin, so these are the
# same value. That is what keeps the SameSite=Lax session cookie working: a
# frontend on a different registrable domain from the API never gets the cookie
# sent on XHR, and sign-in appears to succeed and then does nothing.
APP_BASE_URL=https://skincaresync.example.com
API_BASE_URL=https://skincaresync.example.com

# Must list the real frontend origin. Same-origin deployments never exercise
# CORS, but the value is still validated and still used if a browser preflights.
CORS_ORIGINS=https://skincaresync.example.com

# Empty means the bundle calls /api/... relative to wherever it is served.
# Set it only when the API is on a separate origin -- and then also set
# SESSION_COOKIE_SAMESITE=none on the API. Baked in at BUILD time: changing it
# requires `docker compose build web`, not a restart.
VITE_API_URL=

# Port the nginx container publishes on the host. Terminate TLS in front of it.
WEB_PORT=8080

# --- Email ------------------------------------------------------------------
# Required: production refuses to start with EMAIL_PROVIDER=console, because
# verification and reset links would go nowhere. Any SMTP relay works.
EMAIL_PROVIDER=smtp
EMAIL_FROM=SkincareSync <no-reply@skincaresync.example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Social sign-in (optional) ----------------------------------------------
# A provider appears only when all of its values are set. The redirect URI
# registered with the provider must equal API_BASE_URL + the callback path,
# byte for byte:
#   https://skincaresync.example.com/api/auth/oauth/google/callback
#   https://skincaresync.example.com/api/auth/oauth/apple/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple needs a paid Developer account and a Services ID (not an App ID).
# Mount the .p8 into the api container and point this at the mounted path.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# --- Process ----------------------------------------------------------------
LOG_LEVEL=INFO

# Rate-limit counters live in process memory (skincaresync/ratelimit.py), so
# each worker carries its own budget: 2 workers doubles every configured limit.
# Leave at 1 until those counters move to Redis.
WEB_CONCURRENCY=1

# Only for the catalog importers. See BROWSER_UA in skincaresync/brand_catalog.py.
CATALOG_USER_AGENT=
