# Copy to .env and adjust. Every value below has a working default for local
# development, so an empty .env is fine on a developer machine.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials.

# --- Database (standard libpq names) ----------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
# Defaults to the current OS user when unset.
PGUSER=
PGPASSWORD=

# Connection pool. PGPOOL_MAX is the ceiling on concurrent database work; a
# request waits up to PGPOOL_WAIT_SECONDS for a free slot before the API
# answers 503 rather than failing outright.
PGPOOL_MIN=1
PGPOOL_MAX=10
PGPOOL_WAIT_SECONDS=3
PGCONNECT_TIMEOUT=5
# Server-side ceiling on any single query, in milliseconds.
PGSTATEMENT_TIMEOUT_MS=15000

# --- Application ------------------------------------------------------------
# "production" disables /docs, /redoc and /openapi.json.
SKINCARESYNC_ENV=development
LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set only when the API sits behind a proxy that sets X-Forwarded-For.
# Leaving this off means rate limits key on the socket address, which cannot be
# spoofed; turning it on when there is no proxy lets any client forge its key.
TRUST_PROXY=

# --- Rate limits (requests per minute, per client) --------------------------
RATE_LIMIT_ANALYZE=20
RATE_LIMIT_LOOKUP=30
RATE_LIMIT_CATALOG=300

# --- Upstream product lookup ------------------------------------------------
# Total wall-clock budget shared by every DailyMed and Open Beauty Facts call
# made while serving one lookup, and the per-call ceiling within it.
LOOKUP_BUDGET_SECONDS=8
UPSTREAM_TIMEOUT_SECONDS=4

# Only for the offline catalog importers in scripts/. See the comment on
# BROWSER_UA in skincaresync/brand_catalog.py before changing this.
CATALOG_USER_AGENT=

# --- Authentication ---------------------------------------------------------
# Absolute base URL of the FRONTEND. Every verification and password-reset link
# is built from this and never from the request Host header, which an attacker
# controls. Must be https in production. No trailing slash.
APP_BASE_URL=http://localhost:5173

# Absolute base URL of THIS API. OAuth callbacks land here, not on the frontend,
# and this must match the redirect URI registered with each provider exactly.
# Differs from APP_BASE_URL whenever the two are served from separate origins,
# which is the normal development setup. Must be https in production.
API_BASE_URL=http://localhost:8000

SESSION_COOKIE_NAME=skincaresync_session
CSRF_COOKIE_NAME=skincaresync_csrf
# Defaults to true in production, false elsewhere. Never set false in production.
SESSION_COOKIE_SECURE=
# lax | strict | none. "none" additionally requires SESSION_COOKIE_SECURE=true.
# Keep "lax" unless the frontend is on a different registrable domain.
SESSION_COOKIE_SAMESITE=lax
# Only set when the API and frontend share a parent domain (".example.com").
SESSION_COOKIE_DOMAIN=

# Idle timeout and hard ceiling for a session, in seconds.
SESSION_IDLE_MAX_AGE_SECONDS=1209600
SESSION_ABSOLUTE_MAX_AGE_SECONDS=7776000

EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600

# Echoes verification and reset tokens in API responses so local work and tests
# can complete email flows without a mailbox. Forced OFF in production.
AUTH_DEV_ECHO_TOKENS=

# SQLAlchemy pool for the auth tables (separate from the psycopg2 pool above).
AUTH_POOL_SIZE=5
AUTH_POOL_MAX_OVERFLOW=5

# --- Email ------------------------------------------------------------------
# console | smtp. "console" logs the message and delivers nothing; production
# refuses to start with it. No paid provider is required -- any SMTP relay,
# including a local capture tool such as Mailpit, works.
EMAIL_PROVIDER=console
EMAIL_FROM=SkincareSync <no-reply@localhost>

# Console provider only: also write each message as an .eml file here.
EMAIL_OUTBOX_DIR=

# SMTP provider only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Social sign-in (optional) ----------------------------------------------
# A provider is offered only when ALL of its values below are set, so leaving a
# block empty simply hides that button.

# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application). Register this redirect URI on the client:
#   $API_BASE_URL/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Developer -> Certificates, Identifiers & Profiles.
# APPLE_CLIENT_ID is the Services ID (not the App ID). Register:
#   $API_BASE_URL/api/auth/oauth/apple/callback
# Apple needs a paid Developer account, and its callback is a cross-site form
# POST, which browsers only send cookies on when they are Secure -- so Apple
# cannot be exercised over plain http. Use an https tunnel locally.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Path to the .p8 signing key. Preferred over the inline form below, which puts
# a private key into the process environment.
APPLE_PRIVATE_KEY_PATH=
# Inline alternative for hosts that only offer environment variables. Literal
# "\n" sequences are converted to newlines.
APPLE_PRIVATE_KEY=

# --- Frontend (Vite, read at build time) ------------------------------------
VITE_API_URL=http://localhost:8000
